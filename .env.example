# Application
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# Postgres (local / Compose)
POSTGRES_USER=studio
POSTGRES_PASSWORD=studio
POSTGRES_DB=studio
DATABASE_URL=postgres://studio:studio@localhost:5432/studio

# Local media
STORAGE_DIR=./storage
MAX_PHOTO_BYTES=8388608

# OpenAI (persona, oportunidades, post e imagem)
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1.5

# News (descoberta de tópicos)
NEWS_API_KEY=
NEWS_LOOKBACK_DAYS=21